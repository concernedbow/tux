#!/usr/bin/env python3
"""Run a curated diagnostic scan: tux-scan <area>   (no area lists them)"""
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from tux import sysinfo

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "list"):
    print("usage: tux-scan <area> [area...]\nareas: " + " ".join(sysinfo.SCANS))
    sys.exit(0)
for area in sys.argv[1:]:
    print(f"======== {area} ========")
    print(sysinfo.scan(area))
